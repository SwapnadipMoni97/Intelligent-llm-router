APP_NAME=Intelligent LLM Router
ROUTING_STRATEGY=intelligent
MODEL_REGISTRY_PATH=config/models.yaml
REQUEST_TIMEOUT_SECONDS=45
MAX_RETRIES=2
RETRY_BASE_SECONDS=0.25
RATE_LIMIT_REQUESTS_PER_MINUTE=60
STRUCTURED_LOGS=true
# Provider credentials are read by LiteLLM from the environment. Set only the providers used:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION_NAME=
